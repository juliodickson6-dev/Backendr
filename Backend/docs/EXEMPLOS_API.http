// ===================================
// 7. HEALTH CHECK
// ===================================

GET http://localhost:3000/api/health

RESPOSTA (200):
{
  "status": "API funcionando",
  "timestamp": "2024-06-13T16:25:00.123Z"
}


// ===================================
// 8. INFORMAÇÕES DA API
// ===================================

GET http://localhost:3000/

RESPOSTA (200):
{
  "message": "Backend AJOV - Ficha de Cadastro",
  "version": "1.0.0",
  "endpoints": {
    "health": "/api/health",
    "criar_cadastro": "POST /api/cadastro/criar",
    "listar_cadastros": "GET /api/cadastro/listar",
    "obter_cadastro": "GET /api/cadastro/:id",
    "atualizar_cadastro": "PUT /api/cadastro/:id",
    "deletar_cadastro": "DELETE /api/cadastro/:id"
  }
}


// ===================================
// CÓDIGOS DE STATUS HTTP
// ===================================

200 - OK (Sucesso)
201 - Created (Recurso criado)
400 - Bad Request (Dados inválidos)
404 - Not Found (Recurso não encontrado)
409 - Conflict (Conflito - ex: ID duplicado)
500 - Internal Server Error (Erro do servidor)


// ===================================
// DICAS DE TESTE
// ===================================

1. Use Postman ou Insomnia para testar
2. Copie e cole os exemplos acima
3. Altere os valores conforme necessário
4. Verifique os status codes
5. Observe as respostas em JSON

